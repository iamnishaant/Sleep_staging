# GENERATED by report/gbnf.py from report/claim_schema.py.
# Do not edit by hand - tests/test_grammar_agreement.py asserts this
# file is byte-identical to the generated text, so an edit here fails
# the suite rather than silently diverging from the verifier.
#
# Union of per-type productions: each claim type has its own exact
# field set, field order and enums, so malformed per-type output is
# ungeneratable rather than merely rejected.

root ::= "[" ws (claim (ws "," ws claim)* ws)? "]"

claim ::= value-claim | hedged-claim | observation-claim | review-claim | assoc-claim

# ---- value: exactly one NUMERIC evidence id ----------------------
value-claim ::= "{" ws claim-id ws "," ws "\"claim_type\"" ws ":" ws "\"value\"" ws "," ws numeric-cites ws "," ws this-recording ws "," ws value-field ws "," ws unit-field ws "}"

# ---- hedged_value: identical shape, different type token ---------
hedged-claim ::= "{" ws claim-id ws "," ws "\"claim_type\"" ws ":" ws "\"hedged_value\"" ws "," ws numeric-cites ws "," ws this-recording ws "," ws value-field ws "," ws unit-field ws "}"

# ---- observation: one or more ids, plus a predicate-bound key ----
observation-claim ::= "{" ws claim-id ws "," ws "\"claim_type\"" ws ":" ws "\"observation\"" ws "," ws any-cites ws "," ws this-recording ws "," ws text-key-field ws "}"

# ---- review_flag: exactly one TIER id ----------------------------
review-claim ::= "{" ws claim-id ws "," ws "\"claim_type\"" ws ":" ws "\"review_flag\"" ws "," ws tier-cites ws "," ws this-recording ws "," ws reason-key-field ws "}"

# ---- population_association: subject is population ---------------
assoc-claim ::= "{" ws claim-id ws "," ws "\"claim_type\"" ws ":" ws "\"population_association\"" ws "," ws any-cites ws "," ws population ws "}"

claim-id ::= "\"claim_id\"" ws ":" ws "\"c" digits "\""
this-recording ::= "\"subject\"" ws ":" ws "\"this_recording\""
population ::= "\"subject\"" ws ":" ws "\"population\""
value-field ::= "\"value\"" ws ":" ws number
unit-field ::= "\"unit\"" ws ":" ws ("\"minutes\"" | "\"fraction\"" | "\"count\"" | "\"per hour\"" | "\"ratio\"")
text-key-field ::= "\"text_key\"" ws ":" ws ("\"n1_reliability_is_low\"" | "\"tier_is_low\"")
reason-key-field ::= "\"reason_key\"" ws ":" ws ("\"low_night_confidence\"" | "\"n1_low_reliability\"")

numeric-cites ::= "\"cites\"" ws ":" ws "[" ws numeric-id ws "]"
tier-cites ::= "\"cites\"" ws ":" ws "[" ws tier-id ws "]"
any-cites ::= "\"cites\"" ws ":" ws "[" ws any-id (ws "," ws any-id)* ws "]"

numeric-id ::= "\"arch.total_sleep_time\"" | "\"arch.time_in_bed\"" | "\"arch.sleep_efficiency\"" | "\"arch.sleep_onset_latency\"" | "\"arch.waso\"" | "\"arch.rem_latency\"" | "\"arch.rem_latency_sustained\"" | "\"arch.rem_periods\"" | "\"arch.stage_transitions\"" | "\"arch.transition_rate\"" | "\"arch.light_deep_ratio\"" | "\"arch.wake_interruptions_per_hour\"" | "\"stage.W.fraction\"" | "\"stage.N1.fraction\"" | "\"stage.N2.fraction\"" | "\"stage.N3.fraction\"" | "\"stage.REM.fraction\""

tier-id ::= "\"night.confidence\"" | "\"model.n1_reliability_warning\""

any-id ::= numeric-id | tier-id

digits ::= [0-9]+
number ::= "-"? [0-9]+ ("." [0-9]+)?
ws ::= [ \t\n]*
